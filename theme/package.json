{
  "name": "@local/dsh-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Midnight theme: restyles the Harness Web UI through its own design tokens",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./palette": "./palette.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "palette.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}
